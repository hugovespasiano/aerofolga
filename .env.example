# ==============================================================================
# AEROFOLGA — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# Supabase Público (Client-Side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Supabase Privado (Server-Side Apenas — NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Alertas Passivos (Canais de Notificação do Casal)
# Telegram Bot (Opção 1: Sem custo e entrega imediata)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# WhatsApp (Opção 2: API de Notificações Z-API / Evolution / Twilio)
WHATSAPP_API_URL=https://api.example.com
WHATSAPP_API_TOKEN=your-whatsapp-token

# Radar de Passagens (APIs e Provedores)
# BrasilAPI (100% Gratuita e pública para feriados nacionais — Não exige chave)
# BRASIL_API_BASE_URL=https://brasilapi.com.br/api
