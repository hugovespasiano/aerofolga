# ==============================================================================
# AEROFOLGA — VARIÁVEIS DE AMBIENTE (.env.example)
# Vespasiano Labs — Governança e Blindagem de Segurança
# ==============================================================================

# 1. Supabase (Camada de Dados e Autenticação)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Webhooks Financeiros e Pagamentos
PAYMENT_WEBHOOK_SECRET=your-webhook-hmac-secret-min-32-chars

# 3. Proteção Anti-Robô (Cloudflare Turnstile)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your-turnstile-site-key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# 4. Alertas do Casal — Telegram (Recomendado / Gratuito e Imediato)
# Crie o bot no Telegram pesquisando por @BotFather e digitando /newbot
# Para descobrir seu Chat ID, mande uma mensagem para o bot @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 5. Alertas do Casal — WhatsApp (Opcional - Evolution API)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=aerofolga
WHATSAPP_NUMERO=5524999999999

# 6. Provedores de Voos (Opcional)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
KIWI_API_KEY=
